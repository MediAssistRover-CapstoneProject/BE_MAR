# Copy this file to .env only for local development. Never commit .env.

# Local Docker Compose MySQL
MYSQL_DATABASE=backend_robot_v1
MYSQL_ROOT_PASSWORD=replace-me
MYSQL_USER=mediassist
MYSQL_PASSWORD=replace-me

# Spring profile and remote MySQL (Railway + Aiven)
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://AIVEN_HOST:AIVEN_PORT/backend_robot_v1?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=mediassist_app
DB_PASSWORD=replace-with-aiven-password

# Use two different random values. Do not reuse the MQTT or admin password.
JWT_SECRET=replace-with-at-least-64-random-bytes
DEVICE_JWT_SECRET=replace-with-a-different-64-byte-random-secret
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_EMAIL=admin@example.com
ADMIN_ACCOUNT_CODE=ADMIN001
ADMIN_FULL_NAME=System Administrator

PUBLIC_BASE_URL=https://YOUR_BACKEND_DOMAIN.up.railway.app
CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
OPERATIONS_SCHEDULER_ENABLED=true

# Enable the broker connection only after the first HTTP-only deployment succeeds.
MQTT_ENABLED=false
MQTT_DISPATCH_ENABLED=false
MQTT_BROKER_URI=ssl://YOUR_EMQX_HOST:8883
MQTT_CLIENT_ID=mar-backend-prod
MQTT_USERNAME=mar-backend
MQTT_PASSWORD=replace-with-emqx-backend-password
MQTT_ROBOT_IDS=
MQTT_ENABLED_STEP_TYPES=WAIT,MOVE,CONTROL_HARDWARE,EXECUTE_SENSING
MQTT_ALLOW_SIMULATION=false

MAPPING_ENABLED=false
MAPPING_STORAGE_DIR=/app/data/map-artifacts

# Production HTTPS profile. Directory must contain fullchain.pem and privkey.pem.
BACKEND_BIND_ADDRESS=127.0.0.1
HTTPS_PORT=443
TLS_CERT_DIR=./secrets/tls

# MQTT over TLS (EMQX broker Address, not its console URL).
MQTT_ENABLED=false
MQTT_DISPATCH_ENABLED=false
MQTT_BROKER_URI=ssl://localhost:8883
MQTT_CLIENT_ID=mar-be-mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ROBOT_IDS=
MQTT_ENABLED_STEP_TYPES=WAIT,EXECUTE_SENSING
MQTT_ALLOW_COMMISSIONING_UNLOCK=false
MQTT_NAVIGATION_PROFILE_SYNC_ENABLED=true
MQTT_PUBLISH_RATE_PER_SECOND=8
MQTT_PUBLISH_QUEUE_CAPACITY=64
MQTT_ALLOW_SIMULATION=false
MAPPING_ENABLED=false
AI_SENSING_ENABLED=false
