MYSQL_DATABASE=backend_robot_v1
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=mediassist
MYSQL_PASSWORD=change-me

JWT_SECRET=replace-with-at-least-32-random-bytes
DEVICE_JWT_SECRET=replace-with-a-different-32-byte-random-secret
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Amazon S3 media storage. Never commit real credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=mediassistrover-media-2026

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_ACCOUNT_CODE=
ADMIN_FULL_NAME=

PUBLIC_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
OPERATIONS_SCHEDULER_ENABLED=true

# Production HTTPS profile. Directory must contain fullchain.pem and privkey.pem.
BACKEND_BIND_ADDRESS=127.0.0.1
HTTPS_PORT=443
TLS_CERT_DIR=./secrets/tls

# MQTT over TLS (EMQX broker Address, not its console URL).
MQTT_ENABLED=false
MQTT_DISPATCH_ENABLED=false
MQTT_BROKER_URI=ssl://localhost:8883
MQTT_CLIENT_ID=mar-be-mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ROBOT_IDS=
MQTT_ENABLED_STEP_TYPES=MOVE
MQTT_ALLOW_COMMISSIONING_UNLOCK=false
MQTT_NAVIGATION_PROFILE_SYNC_ENABLED=true
MQTT_PUBLISH_RATE_PER_SECOND=8
MQTT_PUBLISH_QUEUE_CAPACITY=64
MQTT_ALLOW_SIMULATION=false
MAPPING_ENABLED=false
AI_SENSING_ENABLED=false

# OpenAI Vietnamese speech. Set the key privately in .env; never commit it.
TTS_ENABLED=false
OPENAI_API_KEY=
OPENAI_TTS_VOICE=coral
OPENAI_TTS_SPEED=1.0

OPENAI_TTS_MODEL=gpt-realtime-2.1-mini

# Knowledge RAG / bilingual assistant. Keep action flags off until acceptance on hardware.
ASSISTANT_ENABLED=false
ASSISTANT_PUBLIC_ENABLED=false
ASSISTANT_VOICE_ACTIONS_ENABLED=false
ASSISTANT_PI_BRIDGE_ENABLED=false
ASSISTANT_PUBLIC_ROBOT_IDS=
ASSISTANT_TRUST_FORWARDED_FOR=false
ASSISTANT_PUBLIC_RATE_LIMIT_PER_MINUTE=30
ASSISTANT_SESSION_TTL_MINUTES=30
ASSISTANT_RETENTION_DAYS=90
OPENAI_RESPONSE_MODEL=gpt-6.1-sol
OPENAI_OCR_MODEL=gpt-6.1-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_REALTIME_TTS_MODEL=gpt-realtime-2.1-mini
QDRANT_URL=http://qdrant:6333
QDRANT_PORT=6333
QDRANT_BIND_ADDRESS=127.0.0.1
QDRANT_COLLECTION=mediassist_knowledge
