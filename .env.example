MYSQL_DATABASE=backend_robot_v1
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=mediassist
MYSQL_PASSWORD=change-me

JWT_SECRET=replace-with-at-least-32-random-bytes
DEVICE_JWT_SECRET=replace-with-a-different-32-byte-random-secret
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_ACCOUNT_CODE=
ADMIN_FULL_NAME=

PUBLIC_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
OPERATIONS_SCHEDULER_ENABLED=true

# Production HTTPS profile. Directory must contain fullchain.pem and privkey.pem.
BACKEND_BIND_ADDRESS=127.0.0.1
HTTPS_PORT=443
TLS_CERT_DIR=./secrets/tls

# MQTT over TLS (EMQX broker Address, not its console URL).
MQTT_ENABLED=false
MQTT_DISPATCH_ENABLED=false
MQTT_BROKER_URI=ssl://localhost:8883
MQTT_CLIENT_ID=mar-be-mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ROBOT_IDS=
MQTT_ENABLED_STEP_TYPES=WAIT,EXECUTE_SENSING
MQTT_ALLOW_COMMISSIONING_UNLOCK=false
MQTT_NAVIGATION_PROFILE_SYNC_ENABLED=true
MQTT_PUBLISH_RATE_PER_SECOND=8
MQTT_PUBLISH_QUEUE_CAPACITY=64
MQTT_ALLOW_SIMULATION=false
MAPPING_ENABLED=false
AI_SENSING_ENABLED=false

# OpenAI Vietnamese speech. Set the key privately in .env; never commit it.
TTS_ENABLED=false
OPENAI_API_KEY=
OPENAI_TTS_VOICE=coral
OPENAI_TTS_SPEED=1.0

OPENAI_TTS_MODEL=gpt-4o-mini-tts
