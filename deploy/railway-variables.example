# Paste into Railway > backend service > Variables > Raw Editor.
# Replace every CHANGE_ME value before deploying.

SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:mysql://CHANGE_ME_AIVEN_HOST:CHANGE_ME_AIVEN_PORT/defaultdb?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=avnadmin
DB_PASSWORD=CHANGE_ME_AIVEN_PASSWORD

JWT_SECRET=CHANGE_ME_RANDOM_SECRET_1
DEVICE_JWT_SECRET=CHANGE_ME_RANDOM_SECRET_2
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=mediassist-rover
DEVICE_JWT_EXPIRATION_MS=3600000
DEVICE_JWT_ISSUER=mediassist-rover-device

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_EMAIL=CHANGE_ME_EMAIL
ADMIN_ACCOUNT_CODE=ADMIN001
ADMIN_FULL_NAME=System Administrator

CORS_ALLOWED_ORIGINS=https://CHANGE_ME_FRONTEND_DOMAIN
PUBLIC_BASE_URL=https://CHANGE_ME_BACKEND_DOMAIN
OPERATIONS_SCHEDULER_ENABLED=true
DDL_AUTO=validate

MQTT_ENABLED=false
MQTT_DISPATCH_ENABLED=false
MQTT_BROKER_URI=ssl://CHANGE_ME_EMQX_HOST:8883
MQTT_CLIENT_ID=mar-backend-prod
MQTT_USERNAME=mar-backend
MQTT_PASSWORD=CHANGE_ME_EMQX_BACKEND_PASSWORD
MQTT_ROBOT_IDS=
MQTT_ENABLED_STEP_TYPES=AUTHENTICATE,CONTROL_HARDWARE,MOVE,WAIT,INTERACT,HANDLE_PAYLOAD,DATA_SERVICE,SET_CONTEXT,CHECK_CONDITION,EXECUTE_SENSING,NOTIFY
MQTT_ALLOW_SIMULATION=false

MAPPING_ENABLED=false
MAPPING_STORAGE_DIR=/app/data/map-artifacts
AI_SENSING_ENABLED=false
