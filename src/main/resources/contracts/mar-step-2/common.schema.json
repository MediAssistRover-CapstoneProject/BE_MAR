{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediassistrover.invalid/contracts/phase0/common.schema.json",
  "title": "Shared contract fields",
  "$comment": "Bundled schema-3 validation contract reconstructed from BE handoff Markdown. Pi implementation remains unverified; semantic and Job-scope checks are implemented in Java.",
  "x-provenance": {
    "status": "RECONSTRUCTED_UNVERIFIED_PI",
    "sources": [
      "../01_Giao_tiep_va_toan_bo_field.md",
      "../02_Input_Output_11_Step_Type.md"
    ],
    "baselineDate": "2026-10-12"
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "pose": {
      "type": "object",
      "properties": {
        "x_m": {
          "type": "number"
        },
        "y_m": {
          "type": "number"
        },
        "yaw_rad": {
          "type": "number"
        }
      },
      "required": [
        "x_m",
        "y_m",
        "yaw_rad"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "item_code": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "item_code",
        "quantity"
      ],
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "endpoint_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "endpoint_code": {
          "type": "string",
          "minLength": 1
        },
        "endpoint_name": {
          "type": "string",
          "minLength": 1
        },
        "x_m": {
          "type": "number"
        },
        "y_m": {
          "type": "number"
        },
        "yaw_rad": {
          "type": "number"
        }
      },
      "required": [
        "endpoint_id",
        "endpoint_code",
        "endpoint_name",
        "x_m",
        "y_m",
        "yaw_rad"
      ],
      "additionalProperties": false
    },
    "mappingSession": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "job_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "state": {
          "enum": [
            "STARTING",
            "MAPPING",
            "SAVING",
            "SAVED_LOCAL",
            "SAVED",
            "STOPPED",
            "ABORTED",
            "RECOVERY_REQUIRED",
            "OPERATOR_RECONCILED"
          ]
        },
        "session_open": {
          "type": "boolean"
        },
        "preview_rate_hz": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 1
        },
        "artifact_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "artifact_dir": {
          "type": "string",
          "minLength": 1
        },
        "reconciliation_reason": {
          "type": "string",
          "minLength": 1
        },
        "reconciled_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "asset_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        },
        "resolution_m_per_pixel": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "origin_x_m": {
          "type": "number"
        },
        "origin_y_m": {
          "type": "number"
        },
        "origin_yaw_rad": {
          "type": "number"
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "artifact_id",
        "asset_hash",
        "width_px",
        "height_px",
        "resolution_m_per_pixel",
        "width_m",
        "height_m",
        "origin_x_m",
        "origin_y_m",
        "origin_yaw_rad",
        "frame_id"
      ],
      "additionalProperties": false
    }
  }
}
