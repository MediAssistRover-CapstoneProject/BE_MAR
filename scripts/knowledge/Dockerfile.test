FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-vie tesseract-ocr-eng libreoffice-writer fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /tests
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt pytest pypdf reportlab && python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"
COPY . .
CMD ["python", "-m", "pytest", "-q"]
