{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediassistrover.invalid/contracts/phase0/mapping-artifact.schema.json",
  "title": "Artifact manifest and HTTP upload receipt",
  "$comment": "BE schema 3 design, not enabled in runtime. Derived from Markdown 11/10/2026 plus explicit Phase 0 decisions.",
  "x-provenance": {
    "status": "PLANNED_BE_SCHEMA_3",
    "sources": [
      "../02_Input_Output_11_Step_Type.md",
      "../phase0-contract-baseline.md"
    ],
    "baselineDate": "2026-10-12"
  },
  "oneOf": [
    {
      "$ref": "common.schema.json#/$defs/artifact"
    },
    {
      "type": "object",
      "properties": {
        "stored": {
          "const": true
        },
        "artifactId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "assetHash": {
          "$ref": "common.schema.json#/$defs/hash"
        }
      },
      "required": [
        "stored",
        "artifactId",
        "assetHash"
      ],
      "additionalProperties": false
    }
  ]
}
