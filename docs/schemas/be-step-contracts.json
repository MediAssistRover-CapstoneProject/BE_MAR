{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediassistrover.invalid/contracts/phase0/be-step-contracts.json",
  "title": "Resolved BE inputs and completed outputs (planned schema 3)",
  "$comment": "BE schema 3 design, not enabled in runtime. Derived from Markdown 11/10/2026 plus explicit Phase 0 decisions.",
  "x-provenance": {
    "status": "PLANNED_BE_SCHEMA_3",
    "sources": [
      "../02_Input_Output_11_Step_Type.md",
      "../phase0-contract-baseline.md"
    ],
    "baselineDate": "2026-10-12"
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "stepType": {
          "const": "INTERACT"
        },
        "input": {
          "$ref": "be-step-contracts.json#/$defs/INTERACTInput"
        },
        "output": {
          "$ref": "be-step-contracts.json#/$defs/INTERACTOutput"
        }
      },
      "required": [
        "stepType",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "stepType": {
          "const": "DATA_SERVICE"
        },
        "input": {
          "$ref": "be-step-contracts.json#/$defs/DATA_SERVICEInput"
        },
        "output": {
          "$ref": "be-step-contracts.json#/$defs/DATA_SERVICEOutput"
        }
      },
      "required": [
        "stepType",
        "input"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "input": {
                "properties": {
                  "service_key": {
                    "const": "QUERY_HOSPITAL_INFORMATION"
                  }
                },
                "required": [
                  "service_key"
                ]
              }
            },
            "required": [
              "input",
              "output"
            ]
          },
          "then": {
            "properties": {
              "output": {
                "properties": {
                  "data": {
                    "$ref": "be-step-contracts.json#/$defs/QUERY_HOSPITAL_INFORMATIONData"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "input": {
                "properties": {
                  "service_key": {
                    "const": "RESOLVE_TARGETS"
                  }
                },
                "required": [
                  "service_key"
                ]
              }
            },
            "required": [
              "input",
              "output"
            ]
          },
          "then": {
            "properties": {
              "output": {
                "properties": {
                  "data": {
                    "$ref": "be-step-contracts.json#/$defs/RESOLVE_TARGETSData"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "input": {
                "properties": {
                  "service_key": {
                    "const": "SELECT_TARGET"
                  }
                },
                "required": [
                  "service_key"
                ]
              }
            },
            "required": [
              "input",
              "output"
            ]
          },
          "then": {
            "properties": {
              "output": {
                "properties": {
                  "data": {
                    "$ref": "be-step-contracts.json#/$defs/SELECT_TARGETData"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "input": {
                "properties": {
                  "service_key": {
                    "const": "CHECK_TARGET"
                  }
                },
                "required": [
                  "service_key"
                ]
              }
            },
            "required": [
              "input",
              "output"
            ]
          },
          "then": {
            "properties": {
              "output": {
                "properties": {
                  "data": {
                    "$ref": "be-step-contracts.json#/$defs/CHECK_TARGETData"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "input": {
                "properties": {
                  "service_key": {
                    "const": "CREATE_FALL_INCIDENT"
                  }
                },
                "required": [
                  "service_key"
                ]
              }
            },
            "required": [
              "input",
              "output"
            ]
          },
          "then": {
            "properties": {
              "output": {
                "properties": {
                  "data": {
                    "$ref": "be-step-contracts.json#/$defs/CREATE_FALL_INCIDENTData"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "input": {
                "properties": {
                  "service_key": {
                    "const": "COMMIT_MAP_ARTIFACT"
                  }
                },
                "required": [
                  "service_key"
                ]
              }
            },
            "required": [
              "input",
              "output"
            ]
          },
          "then": {
            "properties": {
              "output": {
                "properties": {
                  "data": {
                    "$ref": "be-step-contracts.json#/$defs/COMMIT_MAP_ARTIFACTData"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "stepType": {
          "const": "AUTHENTICATE"
        },
        "input": {
          "$ref": "be-step-contracts.json#/$defs/AUTHENTICATEInput"
        },
        "output": {
          "$ref": "be-step-contracts.json#/$defs/AUTHENTICATEOutput"
        }
      },
      "required": [
        "stepType",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "stepType": {
          "const": "HANDLE_PAYLOAD"
        },
        "input": {
          "$ref": "be-step-contracts.json#/$defs/HANDLE_PAYLOADInput"
        },
        "output": {
          "$ref": "be-step-contracts.json#/$defs/HANDLE_PAYLOADOutput"
        }
      },
      "required": [
        "stepType",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "stepType": {
          "const": "NOTIFY"
        },
        "input": {
          "$ref": "be-step-contracts.json#/$defs/NOTIFYInput"
        },
        "output": {
          "$ref": "be-step-contracts.json#/$defs/NOTIFYOutput"
        }
      },
      "required": [
        "stepType",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "stepType": {
          "const": "WAIT"
        },
        "input": {
          "$ref": "be-step-contracts.json#/$defs/WAITInput"
        },
        "output": {
          "$ref": "be-step-contracts.json#/$defs/WAITOutput"
        }
      },
      "required": [
        "stepType",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "stepType": {
          "const": "CHECK_CONDITION"
        },
        "input": {
          "$ref": "be-step-contracts.json#/$defs/CHECK_CONDITIONInput"
        },
        "output": {
          "$ref": "be-step-contracts.json#/$defs/CHECK_CONDITIONOutput"
        }
      },
      "required": [
        "stepType",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "stepType": {
          "const": "SET_CONTEXT"
        },
        "input": {
          "$ref": "be-step-contracts.json#/$defs/SET_CONTEXTInput"
        },
        "output": {
          "$ref": "be-step-contracts.json#/$defs/SET_CONTEXTOutput"
        }
      },
      "required": [
        "stepType",
        "input"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "INTERACTInput": {
      "type": "object",
      "properties": {
        "prompt_key": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "DISPLAY",
            "CAPTURE_INPUT",
            "CONFIRM",
            "SPEAK"
          ]
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "prompt_key",
        "action",
        "data"
      ],
      "additionalProperties": false
    },
    "INTERACTOutput": {
      "type": "object",
      "properties": {
        "completed": {
          "const": true
        },
        "prompt_key": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "DISPLAY",
            "CAPTURE_INPUT",
            "CONFIRM",
            "SPEAK"
          ]
        },
        "confirmed": {
          "type": "boolean"
        },
        "closed": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "values": {
          "type": "object"
        },
        "source": {
          "enum": [
            "STAFF_MANUAL",
            "UI",
            "AUDIO_CLIENT"
          ]
        },
        "actor_account_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "completed",
        "prompt_key",
        "action",
        "source",
        "actor_account_id",
        "completed_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "CONFIRM",
                  "CAPTURE_INPUT"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "confirmed"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "prompt_key": {
                "enum": [
                  "CLOSE_SENDER",
                  "CLOSE_RECEIVER",
                  "CONFIRM_COMPARTMENT_CLOSED",
                  "STAFF_CLOSE_DOOR_AND_CLEAR_MECHANISM"
                ]
              }
            },
            "required": [
              "prompt_key"
            ]
          },
          "then": {
            "required": [
              "closed"
            ],
            "properties": {
              "source": {
                "const": "STAFF_MANUAL"
              },
              "actor_account_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "prompt_key": {
                "enum": [
                  "VERIFY_SENDER",
                  "VERIFY_RECEIVER",
                  "VERIFY_COMPARTMENT_LOCKED",
                  "STAFF_PHYSICALLY_VERIFY_LOCK"
                ]
              }
            },
            "required": [
              "prompt_key"
            ]
          },
          "then": {
            "required": [
              "locked"
            ],
            "properties": {
              "source": {
                "const": "STAFF_MANUAL"
              },
              "actor_account_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "STAFF_MANUAL"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "actor_account_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              }
            }
          }
        }
      ]
    },
    "DATA_SERVICEInput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "service_key": {
              "const": "QUERY_HOSPITAL_INFORMATION"
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "language_code": {
              "type": "string",
              "minLength": 1,
              "default": "vi-VN"
            }
          },
          "required": [
            "service_key",
            "question"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "service_key": {
              "const": "RESOLVE_TARGETS"
            },
            "endpoint_group_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          "required": [
            "service_key",
            "endpoint_group_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "service_key": {
              "const": "SELECT_TARGET"
            },
            "targets": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/endpoint"
              }
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "service_key",
            "targets",
            "index"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "service_key": {
              "const": "CHECK_TARGET"
            },
            "endpoint_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          "required": [
            "service_key",
            "endpoint_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "service_key": {
              "const": "CREATE_FALL_INCIDENT"
            },
            "detection_event_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          "required": [
            "service_key",
            "detection_event_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "service_key": {
              "const": "COMMIT_MAP_ARTIFACT"
            },
            "mapping_session_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "artifact_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "floor_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "map_name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "service_key",
            "mapping_session_id",
            "artifact_id",
            "floor_id",
            "map_name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "DATA_SERVICEOutput": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "request_id",
        "data"
      ],
      "additionalProperties": false
    },
    "AUTHENTICATEInput": {
      "type": "object",
      "properties": {
        "purpose": {
          "enum": [
            "DELIVERY_SENDER",
            "DELIVERY_RECEIVER"
          ]
        },
        "service_request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      },
      "required": [
        "purpose",
        "service_request_id"
      ],
      "additionalProperties": false
    },
    "AUTHENTICATEOutput": {
      "type": "object",
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "verification_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "actor_account_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "purpose": {
          "enum": [
            "DELIVERY_SENDER",
            "DELIVERY_RECEIVER"
          ]
        },
        "service_request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "verified",
        "verification_id",
        "actor_account_id",
        "purpose",
        "service_request_id",
        "verified_at",
        "valid_until"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "verified": {
                "const": true
              }
            },
            "required": [
              "verified"
            ]
          },
          "then": {
            "properties": {
              "verification_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "actor_account_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "verified_at": {
                "type": "string",
                "format": "date-time"
              },
              "valid_until": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "else": {
            "properties": {
              "verification_id": {
                "type": "null"
              },
              "verified_at": {
                "type": "null"
              },
              "valid_until": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "HANDLE_PAYLOADInput": {
      "type": "object",
      "properties": {
        "action": {
          "enum": [
            "LOAD",
            "UNLOAD"
          ]
        },
        "service_request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "compartment_id": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/item"
          },
          "minItems": 1
        }
      },
      "required": [
        "action",
        "service_request_id",
        "compartment_id",
        "items"
      ],
      "additionalProperties": false
    },
    "HANDLE_PAYLOADOutput": {
      "type": "object",
      "properties": {
        "confirmed": {
          "type": "boolean"
        },
        "action": {
          "enum": [
            "LOAD",
            "UNLOAD"
          ]
        },
        "service_request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "compartment_id": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/item"
          },
          "minItems": 1
        },
        "actor_account_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "const": "STAFF_MANUAL"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "confirmed",
        "action",
        "service_request_id",
        "compartment_id",
        "items",
        "actor_account_id",
        "confirmed_at",
        "source"
      ],
      "additionalProperties": false
    },
    "NOTIFYInput": {
      "type": "object",
      "properties": {
        "notification_type": {
